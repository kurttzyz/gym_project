# Run scripts/init_dev_env.py to generate an ignored .env for local development.
DJANGO_DEBUG=true
PLATFORM_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gym_platform
PGUSER=gym_platform
PGPASSWORD=
# Privileged connection for database/role provisioning only.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=
# Optional PGADMIN_HOST, PGADMIN_PORT, PGADMIN_DATABASE (default postgres).
# Keep stable; tenant database passwords are derived from this secret and gym UUIDs.
GYM_DATABASE_SECRET=
# For remote production PostgreSQL, use verify-full and a trusted CA.
PGSSLMODE=prefer

APP_TIME_ZONE=Asia/Manila

# Absolute path to a private file based on deploy/copay.example.json.
COPAY_CONFIG_FILE=

# Instructions shown only to gym owners on the platform subscription billing page.
PLATFORM_BILLING_INSTRUCTIONS=Contact Powerhouse for platform subscription payment instructions.
