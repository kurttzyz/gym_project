# Run scripts/init_dev_env.py to generate an ignored .env for local development.
DJANGO_DEBUG=true
PLATFORM_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gym_platform
PGUSER=gym_platform
PGPASSWORD=
# Privileged connection for database/role provisioning only.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=
# Optional PGADMIN_HOST, PGADMIN_PORT, PGADMIN_DATABASE (default postgres).
# Keep stable; tenant database passwords are derived from this secret and gym UUIDs.
GYM_DATABASE_SECRET=
# For remote production PostgreSQL, use verify-full and a trusted CA.
PGSSLMODE=prefer

APP_TIME_ZONE=Asia/Manila

# Absolute path to a private file based on deploy/copay.example.json.
COPAY_CONFIG_FILE=

# Instructions shown only to gym owners on the platform subscription billing page.
PLATFORM_BILLING_INSTRUCTIONS=Contact Powerhouse for platform subscription payment instructions.

# SMTP credentials belong only in ignored environment configuration.
# Use a verified sender address from your email provider (not a gym-supplied From address).
NOTIFICATION_DELIVERY_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=notifications@example.invalid
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional for Docker workers connecting to existing native PostgreSQL:
# WORKER_PGHOST=host.docker.internal
# WORKER_PGPORT=5433

# Optional automatic tenant domains: install the restricted VPS agent first.
DOMAIN_HOSTING_ENABLED=false
DOMAIN_HOSTING_SOCKET=/run/powerhouse-hosting/agent.sock
DOMAIN_HOSTING_IPV4=

# Central member-to-gym collections, separate ledgers and manual payouts.
CENTRAL_COLLECTIONS_ENABLED=false
CENTRAL_COPAY_CONFIG_FILE=
# Keep false until COPAY confirms collection for independent gyms is permitted.
CENTRAL_COLLECTIONS_PRODUCTION_APPROVED=false
# Set true only with loopback-only Gunicorn and an Nginx-overwritten X-Real-IP.
COPAY_TRUST_LOOPBACK_PROXY=false
