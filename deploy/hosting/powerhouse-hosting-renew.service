[Unit]
Description=Renew managed Powerhouse gym HTTPS certificates
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/powerhouse-hosting/venv/bin/python /opt/powerhouse-hosting/renew.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
