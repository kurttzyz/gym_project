[Unit]
Description=Powerhouse restricted domain hosting agent
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/powerhouse-hosting/venv/bin/python /opt/powerhouse-hosting/agent.py
RuntimeDirectory=powerhouse-hosting
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nginx/powerhouse-managed /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/lib/powerhouse-acme

[Install]
WantedBy=multi-user.target
